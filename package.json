{
  "name": "accounting-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous accounting agent — read-only bank/card ingestion, double-entry ledger, tax categorization, per-project cost allocation, and an unsupervised month-end close that always completes.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "migrate": "node --import tsx bin/migrate.ts",
    "seed": "node --import tsx bin/migrate.ts --seed",
    "link": "node --import tsx bin/link.ts",
    "sync": "node --import tsx bin/sync.ts",
    "close": "node --import tsx bin/close-agent.ts",
    "advisor": "node --import tsx bin/advisor.ts",
    "rekey": "node --import tsx bin/rekey.ts",
    "dashboard": "node --import tsx bin/dashboard.ts",
    "export-sheet": "node --import tsx bin/export-sheet.ts",
    "export-year": "node --import tsx bin/export-year.ts",
    "send-digest": "node --import tsx bin/send-digest.ts",
    "google-consent": "node --import tsx bin/google-consent.ts",
    "push-gsheet": "node --import tsx bin/push-gsheet.ts",
    "vapid-keys": "node --import tsx bin/vapid-keys.ts",
    "audit": "node --import tsx bin/audit.ts",
    "advise": "node --import tsx bin/advise.ts",
    "import-statement": "node --import tsx bin/import-statement.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.19.1",
    "postgres": "^3.4.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

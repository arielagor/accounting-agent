# Accounting Agent — environment. Copy to .env (gitignored) and fill in.
# The cron/Task Scheduler launcher does NOT inject env, so these are parsed from .env at runtime.

# --- Database (separate `accounting` db on the existing gbrain-pg Postgres instance) ---
ACCT_DB_URL=postgresql://postgres:local-dev-password@localhost:5433/accounting

# --- Secret encryption (32-byte key, hex or base64). Generate: openssl rand -hex 32 ---
INTEGRATION_ENC_KEY=

# --- SimpleFIN Bridge (read-only bank/card aggregation) ---
# The access URL is obtained once via `npm run link` and stored ENCRYPTED in the DB,
# never here. This is only the bridge base if you self-host; default is the public bridge.
SIMPLEFIN_BRIDGE_URL=https://bridge.simplefin.org

# --- Stripe (READ-ONLY revenue reconciliation; shared account, owner-filter by metadata.app) ---
STRIPE_SECRET_KEY=

# --- Email digests (Gmail SMTP via Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
DIGEST_TO=ariel.agor@gmail.com
DIGEST_FROM=claude@mvat.ai

# --- Autonomy gating ladder: off | draft | live  (default off = inert) ---
CLOSE_MODE=off
# Adjusting entries above this (USD) always escalate, even in live.
AJE_AUTO_THRESHOLD=250
# Single transactions above this (USD) are surfaced for acknowledgement.
LARGE_TXN_REVIEW=1000
# Categorization confidence below this is quarantined, never guessed.
CONFIDENCE_THRESHOLD=0.85
# Reconciliation tolerance in cents (bank should be exact).
RECON_TOLERANCE_CENTS=0
# Out-of-balance delta (cents) above which an account mismatch escalates.
RECON_ESCALATE_DELTA=5000

# --- Tax entity (seeds acct_entity_profile if empty; modular toggle) ---
# sole_prop | single_llc | multi_llc | s_corp | c_corp | organize_only
ENTITY_TYPE=sole_prop
ENTITY_STATE=CA
ENTITY_FILING_STATUS=single

# LLM model for claude -p (categorization/advisory). Fable is often unavailable; pin Sonnet.
LLM_MODEL=claude-sonnet-4-6
